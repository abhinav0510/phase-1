{
  "name": "sidana-platform-phase1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "provision:founders": "node --env-file=.env.local scripts/provision-founders.mjs",
    "provision:admins": "node --env-file=.env.local scripts/provision-admins.mjs",
    "backfill:weekly": "node --env-file=.env.local scripts/backfill-weekly-reports.mjs",
    "migrate:mustreset": "node --env-file=.env.local scripts/migrate-mustreset.mjs",
    "reset:founders": "node --env-file=.env.local scripts/reset-founder-passwords.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:stack": "node node_modules/@playwright/test/cli.js test --config playwright.stack.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "0.469.0",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
