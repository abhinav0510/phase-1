# Copy to /srv/sidana/backup.env on the VPS and run: chmod 600 backup.env
# Every setting is explained in docs/BACKUPS.md. This file holds secrets: never commit it.

# --- Required -------------------------------------------------------------------------
# Supabase dashboard > Connect > Session pooler. Includes the database password.
SUPABASE_DB_URL=
# The age PUBLIC key(s) snapshots are encrypted to (starts age1...). Separate several with
# spaces, so more than one person can restore. The matching private key never goes on the server.
BACKUP_AGE_RECIPIENT=

# --- Storage files (logos, MIS, decks). Set BACKUP_STORAGE=none to skip. --------------
# The same two values as in app.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Off-site copy, via rclone. Set BACKUP_OFFSITE=none to keep copies only on this server.
# Remote name "offsite" is configured by the RCLONE_CONFIG_OFFSITE_ lines. Example for
# Backblaze B2 (use an application key limited to this one bucket):
BACKUP_REMOTE=offsite:your-bucket-name/sidana
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=
# Leave empty to let the bucket's own lifecycle rule delete old copies (recommended).
OFFSITE_KEEP_DAYS=

# --- Alerts ---------------------------------------------------------------------------
# A heartbeat check URL, e.g. from healthchecks.io. It alerts when a run fails or a night is missed.
BACKUP_HEARTBEAT_URL=

# --- Optional extras ------------------------------------------------------------------
# n8n: Settings > n8n API > Create an API key.
N8N_BASE_URL=https://sidanaventures.app.n8n.cloud
N8N_API_KEY=
# Pilot sheet: the ID from its URL, plus a Google service account JSON key, base64-encoded:
#   base64 -i service-account.json | tr -d '\n'
PILOT_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_B64=

# Days of snapshots kept on this server.
BACKUP_KEEP_DAYS=14
