# Copy to /srv/sidana/.env on the VPS. Settings for Compose itself; no secrets.
APP_IMAGE=ghcr.io/abhinav0510/phase-1
DOMAIN=portal.example.com
LETSENCRYPT_EMAIL=you@example.com
# Runs the certificate renewal container.
COMPOSE_PROFILES=tls
# Lower both on a VPS with less than 2 GB of memory. Keep the heap about 70% of the limit.
APP_MEMORY=1g
APP_HEAP_MB=700
