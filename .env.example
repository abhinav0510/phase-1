# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Temporary Phase-1 admin bootstrap password (used by scripts/provision-admins.mjs).
ADMIN_BOOTSTRAP_PASSWORD=<bootstrap password>

# n8n notification workflows (server-only).
# Shared secret checked by both ADMIN-BROADCAST and SYNC-CONTACTS.
N8N_NOTIFY_SECRET=<shared secret>
N8N_BROADCAST_WEBHOOK_URL=https://<instance>.app.n8n.cloud/webhook/<admin-broadcast path>
N8N_CONTACTS_SYNC_WEBHOOK_URL=https://<instance>.app.n8n.cloud/webhook/<contacts-sync path>
